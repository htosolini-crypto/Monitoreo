# Obligatoria (la app no arranca sin ella). Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
MAIL_DEFAULT_SENDER_NAME=Sistema de Gestión y Monitoreo Agronómico
MAIL_DEFAULT_SENDER_EMAIL=tu_correo@gmail.com

# Base de datos. PostgreSQL local (recomendado, soporta varios usuarios concurrentes):
DATABASE_URL=postgresql+psycopg2://cultivos_app:password@localhost:5432/cultivos
# Alternativa para pruebas rápidas sin Postgres instalado (un solo usuario a la vez):
# DATABASE_URL=sqlite:///instance/cultivos.db

# Ubicación de referencia para el widget de clima del dashboard (Open-Meteo, gratis).
WEATHER_LAT=-30.3614
WEATHER_LON=-61.9156
WEATHER_LABEL=San Guillermo, Santa Fe

# Identificación de especies por foto (Pl@ntNet, gratis con registro): https://my.plantnet.org/
PLANTNET_API_KEY=

# NDVI por polígono de lote (Agromonitoring, gratis con registro): https://agromonitoring.com/api
AGROMONITORING_API_KEY=

# --- Solo producción (Railway) ---
# Cookies de sesión solo por HTTPS (dejar vacío o en false en desarrollo local, que usa http):
# SESSION_COOKIE_SECURE=true
# Usuario administrador inicial, que se crea solo si la base no tiene usuarios.
# Sin ADMIN_PASSWORD se genera una aleatoria y se imprime una única vez en el log del deploy:
# ADMIN_USER=admin
# ADMIN_PASSWORD=una-contraseña-larga-de-al-menos-8-caracteres
# ADMIN_EMAIL=tu_correo@gmail.com
